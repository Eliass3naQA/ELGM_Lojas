# Supabase → Project Settings → API (ou "Connect" no topo do painel)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-public-key-aqui
# secreta: só no servidor, nunca exponha no navegador
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# assina o cookie de sessão do comprador (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
